# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files and secrets
.env
.env.*
*.local
*.key
*.p8
*.p12
*.pem
*.crt
*.cert
*.jks
*.keystore
service-account*.json
firebase-adminsdk*.json
supabase-service-role*.json
local.properties
keystore.properties
signing.properties
credentials.env

# android local tooling, signing, and release outputs
/private/android-signing/
/private/android-release/
/android-sdk/
/android-sdk-*/
/android-commandlinetools*/
/android-commandlinetools*.zip
/commandlinetools*/
/commandlinetools*.zip
/jdk/
/jdk-*/
/jdk*.zip
/jdk*.tar.gz
/openjdk*.zip
/openjdk*.tar.gz
/.gradle/
/android-twa/.gradle/
/android-twa/build/
/android-twa/app/build/
*.apk
*.aab
*.apks

# keep non-secret env templates trackable
!.env.example
!.env.*.example

# vercel
.vercel/

